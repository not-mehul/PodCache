# ── Search / discovery ──────────────────────────────────────────────────────
# PodcastIndex.org is the gold-standard open podcast database. Register a free
# key at https://api.podcastindex.org/. If these are unset, PodCache falls back
# to the keyless Apple/iTunes Search API so search still works out of the box.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# ── Ad detection (small, local model — nothing leaves your machine) ─────────
# A small GGUF instruct model run on CPU via llama.cpp reads the transcript and
# flags the sponsor reads. Without a model, PodCache uses an offline heuristic
# detector (phrase matching) instead.
#
# Supply your own model for a fully offline setup…
PODCACHE_LLM_PATH=
# …or let PodCache fetch this one once into models/ (then inference is local):
PODCACHE_LLM_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
PODCACHE_LLM_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# Context window (tokens) and CPU threads (0 = auto).
PODCACHE_LLM_CTX=4096
PODCACHE_LLM_THREADS=0

# ── Transcription (local Whisper via faster-whisper) ────────────────────────
# Model size: tiny | base | small | medium | large-v3. Larger = more accurate,
# slower. "base" is a good default on CPU; go larger if you have a GPU.
PODCACHE_WHISPER_MODEL=base
# Compute type: int8 (CPU), float16 (GPU), int8_float16, etc.
# Use float16 when running on a GPU.
PODCACHE_WHISPER_COMPUTE=int8
# Device: cpu | cuda | auto. `auto` uses the GPU when CUDA is available; to use
# the GPU you need the CUDA 12 runtime — `pip install nvidia-cublas-cu12
# nvidia-cudnn-cu12` (PodCache registers those DLLs for you on Windows).
PODCACHE_WHISPER_DEVICE=auto

# ── Storage ─────────────────────────────────────────────────────────────────
# Where raw downloads and finished, ad-free files are written.
PODCACHE_DATA_DIR=data

# ── Server ──────────────────────────────────────────────────────────────────
PODCACHE_HOST=127.0.0.1
PODCACHE_PORT=8000
