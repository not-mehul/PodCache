# ── Search / discovery ──────────────────────────────────────────────────────
# PodcastIndex.org is the gold-standard open podcast database. Register a free
# key at https://api.podcastindex.org/. If these are unset, PodCache falls back
# to the keyless Apple/iTunes Search API so search still works out of the box.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# ── Downloads ───────────────────────────────────────────────────────────────
# Where downloaded episodes are stored (one sub-folder per show). Absolute or
# relative to the project root. Defaults to ./downloads.
PODCACHE_DOWNLOAD_DIR=downloads
# How many episodes may download at the same time.
PODCACHE_CONCURRENCY=3

# ── Ad removal (Tier 0: chapters) ───────────────────────────────────────────
# After each download, cut any chapter whose title looks like a sponsor read
# (e.g. "Sponsor: ACME", "Ad"). Free — a metadata read plus an ffmpeg stream
# copy, no transcription. Needs the `ffmpeg` binary on PATH; if it's missing,
# downloads still work and ad removal is skipped. Set to 0 to disable.
PODCACHE_REMOVE_ADS=1
# Cross-episode repetition: once a batch of this many episodes from one show
# has downloaded, PodCache fingerprints them (Chromaprint `fpcalc`) and cuts the
# audio that recurs across them — intros, outros, and baked-in host-read ads.
# Needs `fpcalc` + `ffmpeg`; skipped if either is missing.
PODCACHE_DEDUPE_MIN_EPISODES=3
# Review mode: when on (1), newly-detected segments are saved as *pending*
# patterns to listen to and confirm in the Library tab, instead of being cut
# automatically. Confirmed patterns are always applied. Default off.
PODCACHE_REVIEW_ADS=0
# Where learned show profiles (patterns + preview clips) are stored.
PODCACHE_PROFILES_DIR=profiles
# Fingerprint matching tolerance. Chromaprint items of the same audio differ by
# a few bits across re-encodes, so matching is by Hamming distance. Raise
# MAX_BIT_ERR if a show isn't being detected; lower it if unrelated audio is
# wrongly cut. MIN_SECONDS is the minimum length for a recurring segment to
# count as a pattern — ad reads run long, so shorter repeats are ignored.
PODCACHE_FP_MAX_BIT_ERR=8
PODCACHE_FP_MIN_SECONDS=25

# ── Server ──────────────────────────────────────────────────────────────────
PODCACHE_HOST=127.0.0.1
PODCACHE_PORT=8000
